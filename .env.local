# Smart Food Storage Monitoring Dashboard - Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY NOTICE:
# Variables prefixed with VITE_ are embedded directly into the client-side browser JavaScript bundle
# at build time and can be inspected by anyone opening DevTools in their browser.
# This client-side approach is intended strictly for rapid demonstration / evaluation environments,
# and is NOT production-safe secret storage. Do NOT use sensitive production tokens in public deployments.

# Blynk Cloud Regional Server Host
# Defaults to blynk.cloud if left blank.
# Regional clusters: blynk.cloud, fra1.blynk.cloud, lon1.blynk.cloud, ny3.blynk.cloud
VITE_BLYNK_SERVER=blynk.cloud

# Blynk IoT Device Authentication Token (Found in Blynk Device Info tab)
# Keep your real token in .env.local and NEVER commit it to Git or share it in transcripts.
VITE_BLYNK_AUTH_TOKEN=ayPjQjgCj6-RUBwNQR-OkVmK1I9vqmjy
